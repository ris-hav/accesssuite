# Copy this file to `.env.<environment>` (e.g. `.env.development`,
# `.env.staging`, `.env.production`) and fill in real values. Which one
# loads is controlled by NODE_ENV — see prisma.config.ts and
# ConfigModule.forRoot() in app.module.ts.

NODE_ENV="development"
PORT=3000

DATABASE_URL="postgresql://user@localhost:5432/accesssuite_dev?schema=public"

# Secret used to sign/verify JWTs. Generate your own per environment, e.g.:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="15m"

# Frontend origin allowed to make cross-origin (CORS + cookie) requests to this API.
CORS_ORIGIN="http://localhost:4200"
